RewriteEngine On

# Same-origin proxy for the Models and Kernels pages' data. They request
# /api/public/v1 from this site; ServingStudio Sim's read-only public API
# (`python -m public_api serve`) answers it on cayenne (10.158.48.50).
RewriteRule ^api/public/v1(/.*)?$ http://10.158.48.50:5220%{REQUEST_URI} [P,L]
